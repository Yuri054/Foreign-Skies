		"unit_trained":       {"file": "unit.wav",      "bus": "Effects",   "volume_db": -6.0,  "cooldown": 2.0},
		"treaty_signed":      {"file": "treaty.wav",    "bus": "Effects",   "volume_db": -6.0,  "cooldown": 2.0},
